  "components": {
    "schemas": {
      "Fragment": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ended At"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "text": {
            "type": "string",
            "maxLength": 24000,
            "minLength": 1,
            "title": "Text"
          },
          "source": {
            "type": "string",
            "enum": [
              "phone_microphone",
              "watch_import",
              "synthetic_demo"
            ],
            "title": "Source"
          },
          "asr_engine": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Asr Engine"
          },
          "language": {
            "type": "string",
            "maxLength": 24,
            "title": "Language",
            "default": "zh"
          },
          "publish_to_dot": {
            "type": "boolean",
            "title": "Publish To Dot",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "session_id",
          "started_at",
          "ended_at",
          "timezone",
          "text",
          "source",
          "asr_engine"
        ],
        "title": "Fragment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
